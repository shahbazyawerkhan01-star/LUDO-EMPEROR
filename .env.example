# Supabase Records Layer (Optional — leave blank to run in dry-run/in-memory mode)
# The Service Role Key is used exclusively server-side by Node.js and must never be exposed to clients
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional WebRTC TURN Relay Fallback (for strict mobile carrier NATs, e.g., Metered.ca / Cloudflare TURN)
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=